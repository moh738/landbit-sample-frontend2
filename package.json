{
  "name": "landbit-ui",
  "private": true,
  "version": "0.0.63",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --sourcemap false",
    "start:dev": "cross-env VITE_ENV=dev vite",
    "build:dev": "cross-env VITE_ENV=dev tsc -b && cross-env VITE_ENV=dev vite build --sourcemap false",
    "start:stage": "cross-env VITE_ENV=stage vite --mode stage",
    "build:stage": "cross-env VITE_ENV=stage tsc -b && cross-env VITE_ENV=stage vite build --mode stage --sourcemap false",
    "start:prod": "cross-env VITE_ENV=prod vite --mode production --port 15000",
    "build:prod": "cross-env VITE_ENV=prod tsc -b && cross-env VITE_ENV=prod vite build --mode production --sourcemap false",
    "bump:version": "node scripts/bump-version.mjs",
    "lint": "eslint .",
    "preview": "vite preview --port 15000",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@reduxjs/toolkit": "^2.5.0",
    "@sumsub/websdk": "^2.4.1",
    "@tanstack/react-query": "^5.90.5",
    "@types/react-slick": "^0.23.13",
    "@types/slick-carousel": "^1.6.40",
    "@types/socket.io-client": "^3.0.0",
    "axios": "^1.7.9",
    "bignumber.js": "^9.1.2",
    "bootstrap": "^5.3.3",
    "copy-to-clipboard": "^3.3.3",
    "country-state-city": "^3.2.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "ethers": "^6.13.5",
    "formik": "^2.4.6",
    "html2canvas": "^1.4.1",
    "jsbi": "^4.3.0",
    "jspdf": "^3.0.4",
    "libphonenumber-js": "^1.12.13",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.553.0",
    "otp-input-react": "^0.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.7",
    "react-datetime-picker": "^7.0.1",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.5.1",
    "react-paginate": "^8.3.0",
    "react-phone-input-2": "^2.15.1",
    "react-photo-view": "^1.2.7",
    "react-range-slider-input": "3.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.1.3",
    "react-select": "^5.9.0",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-slick": "^0.31.0",
    "recharts": "^2.15.0",
    "redux-persist": "^6.0.0",
    "sass": "^1.83.4",
    "slick-carousel": "^1.8.1",
    "socket.io-client": "^4.8.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash.debounce": "^4.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
